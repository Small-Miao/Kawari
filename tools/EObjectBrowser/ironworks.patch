+	/// 预览选择不改变磁盘上的 SGB，也不改变时间线内容。
+	pub fn preview_timeline(&mut self, index: usize) -> bool {
+		if index >= self.timelines.len() { return false; }
+		for (i, timeline) in self.timelines.iter_mut().enumerate() {
+			timeline.auto_play = i == index;
+		}
+		true
+	}
