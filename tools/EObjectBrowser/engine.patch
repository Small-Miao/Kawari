 impl Scene {
+    /// 物件预览的时间由外部播放条驱动；不会影响磁盘资源。
+    pub fn eobject_time(&mut self, seconds: f32) {
+        self.manual_clock=true;
+        self.clock=seconds.max(0.0)*TICKS;
+        self.dirty=true;
+    }
+
+    pub fn eobject_fit(&mut self) {
+        // 物件需要按实际几何范围取景，区域浏览器的实例中位数会裁掉高模型。
+        let mut min = Vec3::splat(f32::INFINITY);
+        let mut max = Vec3::splat(f32::NEG_INFINITY);
+        for p in &self.placements {
+            if let Some((lo, hi)) = self.models[p.model].bounds {
+                for x in [lo.x, hi.x] { for y in [lo.y, hi.y] { for z in [lo.z, hi.z] {
+                    let point = p.transform.transform_point3(Vec3::new(x,y,z));
+                    min = min.min(point); max = max.max(point);
+                }}}
+            }
+        }
+        let (center, reach) = if min.is_finite() && max.is_finite() {
+            ((min+max)*0.5, ((max-min).length()*0.6).max(2.0))
+        } else { (Vec3::ZERO, 10.0) };
+        self.home = looking_at(center, reach);
+        self.camera = self.home;
+        self.fitted = self.placements.len().max(1);
+        self.dirty = true;
+    }
+
+    pub fn eobject_diagnostics(&self) -> (usize,usize,String) {
+        (self.effect_files.len(), self.effect_files.iter().filter(|e|matches!(e.state,EffectState::Ready(..))).count(), self.passes())
+    }
+
+    pub fn eobject_counts(&self) -> (usize,usize,usize,usize) {
+        (self.models.len(),self.models.iter().filter(|m|m.bounds.is_some()).count(),self.placements.len(),self.effects.len())
+    }
